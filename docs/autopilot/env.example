# Autopilot placeholders only; demo mode needs no provider credentials.
AUTOPILOT_MODE=demo
AUTOPILOT_PLANNER_PROVIDER=unconfigured
AUTOPILOT_BROWSER_PROVIDER=unconfigured
AUTOPILOT_BROWSER_ALLOWED_DOMAINS=
AUTOPILOT_MEMORY_BACKEND=postgres
AUTOPILOT_MEMORY_RETENTION_DAYS=30
AUTOPILOT_EMAIL_ADAPTER=unconfigured
AUTOPILOT_CALENDAR_ADAPTER=unconfigured
AUTOPILOT_DESKTOP_ADAPTER=existing-omniva-agent
AUTOPILOT_EMERGENCY_STOP=false
