# Copy to .env for local backend development. Keep real values out of Git.
DATABASE_URL=sqlite:///./omniva.db
APP_ENV=development
APP_MODE=demo
SECRET_KEY=replace-with-a-random-local-value
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_REQUESTS_PER_MINUTE=20
GEMINI_MAX_REQUESTS_PER_DAY=100
