# Copy to .env for local backend development. Keep real values out of Git.
DATABASE_URL=sqlite:///./omniva.db
APP_ENV=development
APP_MODE=demo
SECRET_KEY=replace-with-a-random-local-value
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_REQUESTS_PER_MINUTE=20
GEMINI_MAX_REQUESTS_PER_DAY=100
GNANI_API_KEY=replace-with-local-secret
# Verified by BHASHALEARN AI POC-01 and POC-02; provider settings are not credentials.
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_AUTH_HEADER=X-API-Key-ID
GNANI_MODEL=prisma-v3.0
GNANI_LANGUAGE=indic-auto
GNANI_OUTPUT_FORMAT=codemix
GNANI_TIMEOUT_SECONDS=60
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=
GNANI_TTS_TIMEOUT_SECONDS=60
